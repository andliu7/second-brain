# Server-only. Never prefix provider secrets with VITE_.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
FAL_KEY=
KIE_API_KEY=

# Set a long random secret before enabling a hosted API (required on Vercel).
APP_ACCESS_TOKEN=
